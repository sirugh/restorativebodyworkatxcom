---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'Massage Services - Sports, Pregnancy, Cupping & More in Austin',
  description:
    'Professional massage services in Austin: sports massage, pregnancy massage, face & scalp massage, cupping therapy, and muscle scraping.',
};

const services = [
  {
    title: 'Sports Massage',
    description:
      'Sports massage is similar to manual therapy at a physical therapy or chiropractic office, focusing on movement, pain relief, and recovery. Techniques may include stretching, mobilization, trigger point therapy, muscle scrapping, and dynamic cupping. Please wear athletic or comfortable clothing that is easy to move in. Best suited for clients wanting to focus on one or two specific areas.',
    image: { src: '~/assets/images/closeups/hands-leg.jpeg', alt: 'sports massage on leg' },
    note: null,
  },
  {
    title: 'Pregnancy Massage',
    description:
      'A customized treatment designed to comfort and support you through each trimester. This massage focuses on easing the unique discomforts of pregnancy, including lower back pain, leg swelling, and fatigue, while promoting deep relaxation and overall well-being. Let this be a moment to feel centered and cared for, as your body embraces these beautiful changes.',
    image: { src: '~/assets/images/closeups/hands-back.jpeg', alt: 'pregnancy massage on back' },
    note: null,
  },
  {
    title: 'Face & Scalp Massage',
    description:
      'Melt away tension and reconnect with a moment of calm. This soothing treatment combines relaxing facial massage, scalp massage, gua sha, and cupping to ease tightness, calm the nervous system, and leave your skin with a natural, healthy glow — an hour dedicated to slowing down and letting go.',
    image: { src: '~/assets/images/closeups/hands-hand.jpeg', alt: 'face and scalp massage' },
    note: '*Add Buccal Intraoral $15',
  },
  {
    title: 'Cupping Therapy',
    description:
      'Cupping therapy is a traditional alternative medicine practice that involves placing cups on the skin to create suction. The suction created by the cups is intended to mobilize blood flow, promote healing, and relieve muscle tension.',
    image: { src: '~/assets/images/closeups/cupping-back.jpeg', alt: 'cupping therapy on back' },
    note: '* Available for appointments of any length at no extra charge',
  },
  {
    title: 'Muscle Scraping',
    description:
      'Instrument Assisted Soft Tissue Mobilization (IASTM) uses specialized tools to massage and manipulate soft tissues in the body. The therapist glides the tools over the skin, applying controlled pressure to address issues in muscles, fascia, and other connective tissues.',
    image: { src: '~/assets/images/closeups/knife-back.jpeg', alt: 'muscle scraping on back' },
    note: '* Available for appointments of any length at no extra charge',
  },
];
---

<Layout metadata={metadata}>
  <!-- Page header -->
  <section class="py-16 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-5xl md:text-6xl mb-4" style="font-family: 'Cormorant Garamond', serif; font-weight: 600;">
        Our Services
      </h1>
      <h2 class="text-2xl md:text-3xl text-[#3d785c] mb-4" style="font-family: 'Cormorant Garamond', serif; font-weight: 600;">
        Therapeutic Massage
      </h2>
      <p class="text-muted text-lg mb-8 leading-relaxed">
        Everybody is different, and every session reflects that. Using a blend of deep tissue, sports
        massage, myofascial release, and relaxation techniques, each session is thoughtfully designed
        around what your body needs that day. Whether you're managing chronic pain, recovering from
        physical activity, or simply carrying the weight of everyday stress, the focus is always on
        helping you feel better, move freely, and get back to doing the things you love most.
      </p>
      <a
        href="https://www.massagebook.com/therapists/restorativebodyworkatx"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#3d785c] hover:bg-[#2a5a42] text-white font-medium px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg text-sm md:text-base"
        style="font-family: 'Nunito', sans-serif;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Book an Appointment
      </a>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-3xl mx-auto px-4">
    <div class="border-t border-[#79b791]/40"></div>
  </div>

  <!-- Service sections -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto space-y-20">
      {
        services.map(({ title, description, image, note }, i) => (
          <div class={`flex flex-col gap-10 items-center ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Image -->
            <div class="w-full md:w-2/5 flex-shrink-0">
              <div class="rounded-2xl overflow-hidden shadow-md" style="aspect-ratio: 4/3;">
                <Image
                  src={image.src}
                  alt={image.alt}
                  class="w-full h-full object-cover object-center"
                  width={600}
                  height={450}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 768px) 100vw, 45vw"
                  loading="eager"
                />
              </div>
            </div>
            <!-- Content -->
            <div class="flex-1">
              <h2
                class="text-3xl md:text-4xl text-[#3d785c] mb-4"
                style="font-family: 'Cormorant Garamond', serif; font-weight: 600;"
              >
                {title}
              </h2>
              <p class="leading-relaxed text-default">{description}</p>
              {note && (
                <p class="mt-4 text-sm text-muted italic border-l-2 border-[#79b791]/50 pl-3">{note}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-12 px-4 text-center">
    <div class="max-w-xl mx-auto bg-white/60 border border-[#79b791]/40 rounded-2xl p-10 shadow-sm">
      <h2 class="text-3xl md:text-4xl mb-3" style="font-family: 'Cormorant Garamond', serif; font-weight: 600;">
        Ready to restore?
      </h2>
      <p class="text-muted mb-6 text-sm">Schedule your session online in minutes.</p>
      <a
        href="https://www.massagebook.com/therapists/restorativebodyworkatx"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#3d785c] hover:bg-[#2a5a42] text-white font-medium px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg"
        style="font-family: 'Nunito', sans-serif;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Book an Appointment
      </a>
    </div>
  </section>
</Layout>
